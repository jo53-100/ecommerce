# Copy to .env and fill in. .env is gitignored — never commit real keys.
#   cp .env.example .env
#
# Loaded by settings.py at startup. Real environment variables take priority,
# so on the VPS you can set these in the systemd unit and skip the file.
# No quotes needed around values, and no spaces around the "=".

# --- Stripe -----------------------------------------------------------------
# Dashboard → Developers → API keys. Test keys while developing.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
# Printed by `stripe listen --forward-to localhost:8000/stripe/webhook/`,
# or the signing secret of the webhook endpoint in the dashboard.
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# ISO currency code, lowercase. Must match your Stripe account's country.
STRIPE_CURRENCY=mxn

# --- Django -----------------------------------------------------------------
# Leave DEBUG on for local development; it MUST be False in production.
DJANGO_DEBUG=True
# Generate one for production: python -c "import secrets; print(secrets.token_urlsafe(50))"
# DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Needed for HTTPS logins behind a proxy, e.g. https://tienda.example
# DJANGO_CSRF_TRUSTED_ORIGINS=
